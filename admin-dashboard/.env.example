# Postgres connection (Compose sets DATABASE_URL for the dashboard container).
# Local npm run dev: point at localhost and POSTGRES_HOST_PORT.
DATABASE_URL=postgres://booking:replace-with-a-strong-password@localhost:5437/espazio_booking_system
DATABASE_SSL=false
# Only set true for managed DBs that require SSL without a public CA (not recommended).
DATABASE_SSL_INSECURE=false

# At least 32 random characters. Generate: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Must be true when served over HTTPS (production nginx).
COOKIE_SECURE=true

# First admin account (created only when no admins exist yet).
# Change the password from Admins > Change my password after first login.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Comma-separated website origins allowed to call the public API. Do not use * in production.
CORS_ORIGIN=https://www.your-website.com

# Public URL prefix when nginx mounts under a path (e.g. /dev/espazio-admin). Leave empty at domain root.
# Client assets also need matching VITE_BASE_PATH at image build time (Compose sets this from BASE_PATH).
BASE_PATH=/dev/espazio-admin
