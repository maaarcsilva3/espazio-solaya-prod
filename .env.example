# Copy to .env and set strong values before deploy.
# Never commit .env. Rotate secrets if they were ever shared.

POSTGRES_USER=booking
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=espazio_booking_system
# Loopback-only host port for emergency DB admin.
POSTGRES_HOST_PORT=5437
# Host folder for Postgres files (outside Docker). Relative to this compose file, or absolute.
POSTGRES_DATA_DIR=./database/data
TZ=UTC

# Dashboard published on loopback for your host nginx to proxy.
# See deploy/nginx-booking-admin.conf.example
HOST_PORT=3000

# nginx location prefix (no trailing slash). Must match VITE build — rebuild after change.
BASE_PATH=/dev/espazio-admin
